# Local Docker Compose overrides. Defaults in docker-compose.yml are for local
# development only; replace these values before any non-local deployment.
POSTGRES_PASSWORD=civicone-local-password
JWT_SECRET_KEY=replace_with_a_random_32_byte_hex_secret

# Optional services
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@civicone.gov
SMTP_TLS=true
