APP_ENV=development
DATABASE_URL=sqlite:///./dev.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://civic_user:civic_secret_pass@localhost:5432/civicone_db
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
